#!/bin/sh
set -eu
takt_bin=$0
while [ -L "$takt_bin" ]; do
  takt_link_dir=$(CDPATH='' cd -- "$(dirname -- "$takt_bin")" && pwd)
  takt_bin=$(readlink "$takt_bin")
  case $takt_bin in
    /*) ;;
    *) takt_bin=$takt_link_dir/$takt_bin ;;
  esac
done
takt_bin_dir=$(CDPATH='' cd -- "$(dirname -- "$takt_bin")" && pwd)
exec node "$takt_bin_dir/../dist/app/mcp/index.js" "$@"
