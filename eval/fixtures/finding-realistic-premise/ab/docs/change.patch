--- a/src/list.mjs
+++ b/src/list.mjs
@@ -0,0 +1,9 @@
+import childProcess from 'node:child_process';
+
+export function listFiles(root) {
+  const output = childProcess.execFileSync('git', ['ls-files', 'logs/'], {
+    cwd: root,
+    encoding: 'utf8',
+  });
+  return output.split('\n').filter(line => line.length > 0).join('\n');
+}
