{
  // Type-checks the tests on this list. Vitest strips types, so a test that
  // drifts from the code it exercises keeps passing while asserting on a shape
  // that no longer exists — this is what catches that.
  //
  // Add a test here when you write or change one. If an older test does not
  // type-check yet, fix the test and then add it; never widen the list to
  // something red.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src/__tests__/ai-caller-output-mode.test.ts",
