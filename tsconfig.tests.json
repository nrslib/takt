    "src/__tests__/conversationSession.test.ts",
    "src/__tests__/exec-assistant-failure.test.ts",
    "src/__tests__/exec-command.test.ts",
    "src/__tests__/exec-tui-conversation.test.ts",
    "src/__tests__/grapheme.test.ts",
    "src/__tests__/helpers/stdinSimulator.ts",
    "src/__tests__/image-attachment-store-seal.test.ts",
    "src/__tests__/instructMode.test.ts",
    "src/__tests__/interactive.test.ts",
    "src/__tests__/mock-scenario-stream-chunks.test.ts",
    "src/__tests__/retry-mode-flow.test.ts",
